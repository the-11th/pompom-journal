<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Special "Usage access" permission. Not a runtime prompt: the user grants
         it once in Settings (the app deep-links there). tools:ignore silences the
         ProtectedPermissions lint that flags it as system-only. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ notifications (optional status pings from the worker). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets us prompt the user to exclude the app from battery optimization
         (the Samsung Device Care gotcha — see README). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TodoPupUsage">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Config deep link: todopup://config?url=...&token=... (the
                 Manage-page config QR). Pre-fills + saves endpoint + token. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="todopup" android:host="config" />
            </intent-filter>
        </activity>
    </application>
</manifest>
