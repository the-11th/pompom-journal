{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "datapom-discord-inbox",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "INBOX", "class_name": "DatapomInbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DatapomInbox"] }]
}
