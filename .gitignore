# Ignore all runtime data (task/journal stores, logs, temp files); keep the
# folder itself via data/.gitkeep so a fresh clone has somewhere to write.
data/*
!data/.gitkeep
__pycache__/
.venv/
.pytest_cache/
*.bak
.superpowers/
# Agent + OS local cruft (Claude Code local config, macOS Finder metadata)
.claude/
.DS_Store
